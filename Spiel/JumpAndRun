#!/usr/bin/env python3
import os
import sys
import time
import random

SETTINGS_FILE = "settings.txt"
HIGHSCORE_FILE = "highscores.txt"

DEFAULT_SETTINGS = {
    "game_speed": "0.15",
    "track_width": "40",
    "track_height": "10",
    "obstacle_rate": "18",
    "max_jump": "4",
    "gravity": "1",
}


def load_settings(filename):
    settings = DEFAULT_SETTINGS.copy()
    if os.path.exists(filename):
        try:
            with open(filename, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if "=" in line:
                        key, value = line.split("=", 1)
                        key = key.strip()
                        value = value.strip()
                        if key in settings:
                            settings[key] = value
        except Exception:
            pass
    else:
        try:
            with open(filename, "w", encoding="utf-8") as f:
                for key, value in settings.items():
                    f.write(f"{key}={value}\n")
        except Exception:
            pass
    return settings


def save_highscores(filename, name, score):
    scores = []
    if os.path.exists(filename):
        try:
            with open(filename, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    parts = line.split(",", 1)
                    if len(parts) == 2:
                        try:
                            scores.append((parts[0], int(parts[1])))
                        except ValueError:
                            continue
        except Exception:
            pass
    scores.append((name, score))
    scores.sort(key=lambda item: item[1], reverse=True)
    scores = scores[:10]
    try:
        with open(filename, "w", encoding="utf-8") as f:
            for player, points in scores:
                f.write(f"{player},{points}\n")
    except Exception:
        pass
    return scores


def read_highscores(filename):
    scores = []
    if os.path.exists(filename):
        try:
            with open(filename, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    parts = line.split(",", 1)
                    if len(parts) == 2:
                        try:
                            scores.append((parts[0], int(parts[1])))
                        except ValueError:
                            continue
        except Exception:
            pass
    return scores


def clear_screen():
    if os.name == "nt":
        os.system("cls")
    else:
        sys.stdout.write("\x1b[2J\x1b[H")
        sys.stdout.flush()


def print_board(width, height, player_x, player_y, obstacles, score):
    rows = [[" "] * width for _ in range(height)]
    for obstacle in obstacles:
        x = obstacle["x"]
        if 0 <= x < width:
            rows[0][x] = "#"
    if 0 <= player_x < width and 0 <= player_y < height:
        rows[player_y][player_x] = "O"
    for y in range(height - 1, -1, -1):
        if y == 0:
            print("+" + "-" * width + "+")
        row = "|" + "".join(rows[y]) + "|"
        print(row)
    print("+" + "-" * width + "+")
    print(f"Score: {score}")
    print("Steuerung: w oder Leertaste zum Springen, q zum Beenden")
    print("Hindernisse mit #, Spieler mit O")


def get_key(timeout=0.0):
    if os.name == "nt":
        try:
            import msvcrt
            start = time.time()
            while time.time() - start < timeout:
                if msvcrt.kbhit():
                    key = msvcrt.getwch()
                    return key
            return None
        except Exception:
            return None
    else:
        import select
        dr, _, _ = select.select([sys.stdin], [], [], timeout)
        if dr:
            return sys.stdin.read(1)
        return None


def enable_raw_mode():
    if os.name != "nt":
        import termios
        import tty
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        tty.setcbreak(fd)
        return old_settings
    return None


def disable_raw_mode(old_settings):
    if os.name != "nt" and old_settings is not None:
        import termios
        fd = sys.stdin.fileno()
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)


def read_player_name():
    try:
        name = input("Name f\u00fcr Highscore: ").strip()
    except Exception:
        name = "Spieler"
    if not name:
        name = "Spieler"
    return name[:16]


def main():
    settings = load_settings(SETTINGS_FILE)
    try:
        speed = float(settings.get("game_speed", "0.15"))
    except ValueError:
        speed = 0.15
    try:
        width = max(20, int(settings.get("track_width", "40")))
    except ValueError:
        width = 40
    try:
        height = max(5, int(settings.get("track_height", "10")))
    except ValueError:
        height = 10
    try:
        obstacle_rate = max(6, int(settings.get("obstacle_rate", "18")))
    except ValueError:
        obstacle_rate = 18
    try:
        max_jump = max(1, int(settings.get("max_jump", "4")))
    except ValueError:
        max_jump = 4
    try:
        gravity = max(1, int(settings.get("gravity", "1")))
    except ValueError:
        gravity = 1

    player_x = min(5, width - 2)
    player_y = 0
    vy = 0
    obstacles = []
    score = 0
    frames_since_last = 0
    running = True

    print("JumpAndRun Spiel startet. Einstellungen werden aus settings.txt geladen.")
    print("Druecke Enter, um zu beginnen.")
    input()

    old_settings = enable_raw_mode()
    try:
        clear_screen()
        while running:
            start = time.time()
            key = get_key(timeout=0.0)
            if key:
                if key.lower() == "q":
                    break
                if key.lower() in ["w", " "] and player_y == 0:
                    vy = max_jump
            if player_y > 0 or vy > 0:
                player_y += vy
                vy -= gravity
                if player_y <= 0:
                    player_y = 0
                    vy = 0
                elif player_y >= height - 1:
                    player_y = height - 1
                    vy = -gravity
            if player_y < 0:
                player_y = 0
                vy = 0

            frames_since_last += 1
            if frames_since_last >= obstacle_rate:
                frames_since_last = 0
                obstacle_x = width - 1
                obstacles.append({"x": obstacle_x})
            for obstacle in obstacles:
                obstacle["x"] -= 1
            obstacles = [o for o in obstacles if o["x"] >= 0]

            collision = any(obstacle["x"] == player_x and player_y == 0 for obstacle in obstacles)
            if collision:
                running = False

            score += 1
            clear_screen()
            print_board(width, height, player_x, player_y, obstacles, score)

            elapsed = time.time() - start
            sleep = max(0.0, speed - elapsed)
            time.sleep(sleep)
    finally:
        disable_raw_mode(old_settings)

    clear_screen()
    print("Spiel vorbei! Dein Score:", score)
    name = read_player_name()
    highscores = save_highscores(HIGHSCORE_FILE, name, score)
    print("Highscores:")
    for index, (player, points) in enumerate(highscores, start=1):
        print(f"{index}. {player} - {points}")
    print("Danke f\u00fcrs Spielen.")


if __name__ == "__main__":
    main()
